<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase 7 simulator host (P7.E1). References the game's assemblies in the install folder; nothing is copied
       into the repository (docs/simulator-integrity.md LG-1). Build with the .NET 9 SDK:
       STS2_DATA_DIR=<game data folder> dotnet build sim -c Release -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <NoWarn>CS0618;CS8632;MSB3277;MSB3243</NoWarn>
    <GameDir>$(STS2_DATA_DIR)</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameDir)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDir)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
